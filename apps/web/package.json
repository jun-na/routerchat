{
    "name": "routerchat-web",
    "version": "0.2.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack --hostname 0.0.0.0 --port 4040",
        "build": "next build --turbopack",
        "build:webpack": "next build --webpack",
        "start": "next start",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install --with-deps chromium",
        "health": "bun run format && bun run typecheck && bun run lint && bun run test",
        "dev:vinext": "vinext dev --port 3001",
        "build:vinext": "vinext build",
        "start:vinext": "wrangler dev --config dist/server/wrangler.json",
        "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
        "cf:d1:create": "wrangler d1 create routerchat-db",
        "cf:d1:migrate:local": "wrangler d1 migrations apply routerchat-db --local",
        "cf:d1:migrate:remote": "wrangler d1 migrations apply routerchat-db --remote",
        "cf:r2:create": "wrangler r2 bucket create routerchat-attachments"
    },
    "dependencies": {
        "@convex-dev/auth": "^0.0.92",
        "@vinext/cloudflare": "^1.0.0-beta.10",
        "clsx": "^2.1.1",
        "convex": "^1.38.0",
        "date-fns": "^4.1.0",
        "highlight.js": "^11.11.1",
        "idb": "^8.0.3",
        "jose": "^6.1.0",
        "lucide-react": "^1.14.0",
        "next": "^16.2.6",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-markdown": "^10.1.0",
        "react-server-dom-webpack": "19.2.6",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0",
        "uuid": "^14.0.0",
        "vinext": "^1.0.0-beta.12"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@cloudflare/vite-plugin": "^1.60.2",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/postcss": "^4.3.0",
        "@tailwindcss/typography": "^0.5.19",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/bun": "^1.3.13",
        "@types/node": "^25.6.2",
        "@types/react": "~19.2.14",
        "@types/react-dom": "~19.2.3",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitejs/plugin-rsc": "^0.5.35",
        "eslint": "^10.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^29.1.1",
        "msw": "^2.14.5",
        "postcss": "^8.5.14",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.3.1",
        "wrangler": "^4.141.0"
    },
    "type": "module"
}
